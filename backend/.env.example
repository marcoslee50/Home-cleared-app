# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs (voice cloning) ────────────────────────────────────
ELEVENLABS_API_KEY=...

# ── D-ID (talking head video) ────────────────────────────────────
DID_API_KEY=Basic ...

# ── Cloudflare R2 (or AWS S3) ─────────────────────────────────────
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET=lifetold-media
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.lifetold.co.uk

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=...

# ── App ───────────────────────────────────────────────────────────
APP_URL=https://lifetold.vercel.app
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for production.
# In development, localhost is always allowed.
ALLOWED_ORIGINS=https://lifetold.co.uk,https://www.lifetold.co.uk
