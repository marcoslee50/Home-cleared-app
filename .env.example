INVOICE_SORT_CODE=                # e.g. 30-94-11
INVOICE_ACCOUNT_NUMBER=           # e.g. 12345678
INVOICE_COMPANY_NAME=Wirral Garden & Property
INVOICE_ADDRESS=Port Sunlight, Wirral, CH62
INVOICE_PHONE=07542 888 772
INVOICE_EMAIL=marcos@gmx.co.uk
INVOICE_WEBSITE=wirralgardenandproperty.com
