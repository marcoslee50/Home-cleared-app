# Auth
APP_PIN=                          # Marcos's chosen PIN (4-6 digits)

# Anthropic
ANTHROPIC_API_KEY=                # From console.anthropic.com

# Google OAuth (Calendar)
GOOGLE_CLIENT_ID=                 # From Google Cloud Console
GOOGLE_CLIENT_SECRET=             # From Google Cloud Console
GOOGLE_REFRESH_TOKEN=             # Generated via /api/auth/google flow
GOOGLE_CALENDAR_ID=               # 3A047282-F975-4640-A173-78DE3C453029

# Google Maps + Distance Matrix (same key, enable both APIs)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # Restricted to Maps JS + Places + Geocoding + Distance Matrix

# Met Office (weather flag)
METOFFICE_API_KEY=                # Free from metoffice.gov.uk/services/data/datapoint
# Wirral station 3414 (Bidston Hill) is hardcoded in lib/weather.ts

# Vercel Blob (photos)
BLOB_READ_WRITE_TOKEN=            # Vercel dashboard -> Storage -> Blob

# Vercel KV (duration log + invoices)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Facebook (WGP Page posts)
FACEBOOK_PAGE_ID=                 # WGP Facebook Page ID
FACEBOOK_PAGE_ACCESS_TOKEN=       # Long-lived Page access token

# Invoice / Company details
